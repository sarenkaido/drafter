{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daftar",
  "mainBinaryName": "Daftar",
  "version": "1.2.0",
  "identifier": "ir.daftar.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Daftar",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Daftar",
    "copyright": "Daftar",
    "shortDescription": "Daftar - Income & Expense",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Persian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "category": "Finance",
    "longDescription": "Daftar is a simple offline income & expense tracker with a Persian interface and Jalali calendar.",
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}